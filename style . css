* { margin: 0; padding: 0; box-sizing: border-box; font-family: sans-serif; }
body { background-color: #000; color: #fff; overflow: hidden; }
.video-container { position: relative; width: 100vw; height: 100vh; display: flex; justify-content: center; align-items: center; }
video { width: 100%; height: 100%; object-fit: cover; }
.overlay { position: absolute; bottom: 20px; left: 0; width: 100%; display: flex; justify-content: space-between; align-items: flex-end; padding: 0 20px; }
.bottom-info h3 { margin-bottom: 10px; }
.side-actions { display: flex; flex-direction: column; align-items: center; gap: 20px; }
.action-btn { text-align: center; font-size: 30px; }
.action-btn span { font-size: 12px; display: block; margin-top: 5px; }
